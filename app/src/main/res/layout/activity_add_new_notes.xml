<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AddNewNotes">

    <TextView
        android:id="@+id/tvAddnotes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Add All notes Here"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/etaddtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:ems="10"
        android:hint="Enter Title"
        android:inputType="text"
        android:textColorHighlight="#332525"
        app:layout_constraintEnd_toEndOf="@+id/tvAddnotes"
        app:layout_constraintStart_toStartOf="@+id/tvAddnotes"
        app:layout_constraintTop_toBottomOf="@+id/tvAddnotes" />

    <EditText
        android:id="@+id/etfulldescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:ems="10"
        android:hint="Enter Full Descriptions"
        android:inputType="textLongMessage"
        android:textColorHighlight="#3A2E2E"
        app:layout_constraintEnd_toEndOf="@+id/etaddtitle"
        app:layout_constraintStart_toStartOf="@+id/etaddtitle"
        app:layout_constraintTop_toBottomOf="@+id/etaddtitle" />

    <Button
        android:id="@+id/btnsavenotes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="360dp"
        android:backgroundTint="#E3A6A6"
        android:text="Save Notes"
        app:layout_constraintEnd_toEndOf="@+id/etfulldescription"
        app:layout_constraintHorizontal_bias="0.394"
        app:layout_constraintStart_toStartOf="@+id/etfulldescription"
        app:layout_constraintTop_toBottomOf="@+id/etfulldescription" />
</androidx.constraintlayout.widget.ConstraintLayout>